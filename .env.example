# Build-time public settings. Production must replace both values.
NEXT_PUBLIC_SITE_URL=https://example.invalid
NEXT_PUBLIC_SITE_ENV=development

# Worker-only enquiry settings. Blank or partial values keep the form
# unavailable. Configure them only after legal/operational approval, migration
# application, and RLS verification. ENQUIRY_RATE_LIMITER is the binding
# declared in wrangler.jsonc. Never rename Worker secrets to NEXT_PUBLIC_*.
SITE_ENV=development
PUBLIC_SITE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ENQUIRY_GATE_KEY=
FORM_ALLOWED_ORIGINS=
PRIVACY_NOTICE_VERSION=
RATE_LIMIT_KEY_SALT=

# Optional Turnstile tuple: leave all three blank to disable it, or configure
# all three together. Partial configuration keeps the entire form unavailable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
